# Banco de dados MySQL
DB_URL=jdbc:mysql://localhost:3306/soulup_db?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Frontend e CORS (separe múltiplas origens por vírgula)
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP: use MailHog local em desenvolvimento ou preencha com seu provedor
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@example.com
SUPPORT_EMAIL=

# Integrações opcionais
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PYTHON_EXECUTABLE=python
PYTHON_SCRIPT_PATH=./ia-python/main.py
APP_UPLOAD_DIR=./uploads/videos
